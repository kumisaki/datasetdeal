rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /legal/{reqId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && firestore.exists(/databases/(default)/documents/requirements/$(reqId))
        && firestore.get(/databases/(default)/documents/requirements/$(reqId)).data.publisherId == request.auth.uid;
    }
  }
}
